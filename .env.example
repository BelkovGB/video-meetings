POSTGRES_DB=video_meetings
POSTGRES_USER=video_meetings
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://video_meetings:change-me-before-production@localhost:5432/video_meetings?schema=public
JWT_SECRET=replace-with-a-long-random-secret
# Keep true for one maximum JWT lifetime after deploying session-aware JWTs; then set false.
ACCEPT_LEGACY_JWT_WITHOUT_SESSION=true
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
UPLOAD_DIR=./var/uploads
UPLOAD_TEMP_DIR=./var/uploads-temp
UPLOAD_MAX_BYTES=1073741824
UPLOAD_MAX_REQUEST_BYTES=1074790400
UPLOAD_MIN_FREE_BYTES=2147483648
UPLOAD_MAX_ACTIVE_UPLOADS=4
UPLOAD_RECONCILIATION_GRACE_MS=86400000
# Transcription worker. TRANSCRIPTION_COMMAND is the recognition executable and
# TRANSCRIPTION_COMMAND_ARGS its fixed arguments as a JSON array; the worker
# appends the prepared audio path. Only the worker process reads these.
TRANSCRIPTION_COMMAND=python
TRANSCRIPTION_COMMAND_ARGS=["../../scripts/transcription/transcribe.py"]
TRANSCRIPTION_FFMPEG_PATH=ffmpeg
TRANSCRIPTION_FFMPEG_ARGS=[]
TRANSCRIPTION_WORK_DIR=./var/transcription
TRANSCRIPTION_POLL_INTERVAL_MS=5000
TRANSCRIPTION_LEASE_TIMEOUT_MS=900000
TRANSCRIPTION_AUDIO_TIMEOUT_MS=3600000
TRANSCRIPTION_RECOGNITION_TIMEOUT_MS=14400000
AVATAR_DIR=./var/avatars/files
AVATAR_TEMP_DIR=./var/avatars/temp
AVATAR_MAX_BYTES=5242880
