{
  "active": true,
  "milestone": "Phase 1: Core Profile API (Tracer Bullet)",
  "branch": "features/profile-phase-1",
  "baseBranch": "master",
  "draftPullRequest": true,

  "maxIterations": 15,
  "maxTurns": 100,
  "maxTestFixAttempts": 5,

  "runtime": {
    "commandTimeoutMs": 300000,
    "validationTimeoutMs": 1800000,
    "codexTimeoutMs": 5400000,
    "networkRetryAttempts": 3,
    "networkRetryBaseDelayMs": 2000,
    "maxPages": 20,
    "reviewRetryAttempts": 3
  },

  "developmentModel": "gpt-5.6-terra",
  "trustedIssueAuthors": ["codex-ai-Goo"],
  "rulesFile": ".agents/ralph-rules.md",
  "prompt": "Прочитай .agents/RALPH.md и следуй правилам оттуда. Возьми issue #{issue_number} «{issue_title}» из milestone «{milestone}» и реализуй её. Соблюдай AGENTS.md и переданные ниже правила Ralph Loop.",

  "preflightScripts": ["db:ready", "db:migrate"],
  "validationScripts": [
    "format:check",
    "lint",
    "build",
    "test:ralph",
    "test:e2e:api",
    "test:e2e:web"
  ],

  "review": {
    "enabled": true,
    "model": "gpt-5.6-terra",
    "schemaFile": ".agents/review.schema.json",
    "outputFile": ".agents/last-review.json"
  },

  "milestoneReview": {
    "enabled": true,
    "model": "gpt-5.6-sol",
    "maxTurns": 150,
    "maxFindings": 10,
    "schemaFile": ".agents/review.schema.json",
    "outputFile": ".agents/last-milestone-review.json"
  }
}
