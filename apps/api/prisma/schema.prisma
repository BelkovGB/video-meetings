generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  passwordHash               String                      @map("password_hash")
  displayName                String?                     @map("display_name")
  avatarStorageKey           String?                     @unique @map("avatar_storage_key")
  avatarMimeType             String?                     @map("avatar_mime_type") @db.VarChar(32)
  avatarSizeBytes            Int?                        @map("avatar_size_bytes")
  avatarUpdatedAt            DateTime?                   @map("avatar_updated_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")
  meetings                   Meeting[]
  meetingParticipations      MeetingParticipant[]
  uploadedMeetingFiles       MeetingFile[]               @relation("UploadedMeetingFiles")
  meetingFileDownloadTickets MeetingFileDownloadTicket[]
  authSessions               AuthSession[]
  ownedTasks                 MeetingSummaryTask[]

  @@map("users")
}

model AuthSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model AvatarStorageReservation {
  storageKey String   @id @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("avatar_storage_reservations")
}

model Meeting {
  id           String               @id @default(cuid())
  title        String               @db.VarChar(255)
  date         DateTime
  ownerId      String?              @map("owner_id")
  owner        User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  participants MeetingParticipant[]
  files        MeetingFile[]
  summary      MeetingSummary?

  @@index([ownerId, createdAt])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId String   @map("meeting_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

enum MeetingFileCategory {
  AUDIO
  VIDEO
  TRANSCRIPT
  DOCUMENT
}

enum TranscriptionJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum MeetingSummaryStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum MeetingFileStatus {
  READY
  DELETING
  MISSING
}

model MeetingFile {
  id                 String                      @id @default(cuid())
  meetingId          String                      @map("meeting_id")
  uploadedById       String?                     @map("uploaded_by_id")
  originalName       String                      @map("original_name") @db.VarChar(255)
  storageKey         String                      @unique @map("storage_key")
  category           MeetingFileCategory
  mimeType           String                      @map("mime_type") @db.VarChar(255)
  sizeBytes          Int                         @map("size_bytes")
  status             MeetingFileStatus           @default(READY)
  sourceFileId       String?                     @unique @map("source_file_id")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  meeting            Meeting                     @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  uploadedBy         User?                       @relation("UploadedMeetingFiles", fields: [uploadedById], references: [id], onDelete: SetNull)
  downloadTickets    MeetingFileDownloadTicket[]
  // Restrict, not Cascade: a cascade would drop the transcript row together
  // with the only copy of its storage key and leave its bytes on disk until
  // storage reconciliation notices, a day later. Deleting a recording deletes
  // its transcript row first, on purpose.
  sourceFile         MeetingFile?                @relation("MeetingFileTranscript", fields: [sourceFileId], references: [id], onDelete: Restrict)
  transcript         MeetingFile?                @relation("MeetingFileTranscript")
  transcriptionJob   TranscriptionJob?
  summaryTaskSources MeetingSummaryTaskSource[]

  @@index([meetingId, status, createdAt])
  @@index([meetingId, status, uploadedById])
  @@index([status, createdAt, id])
  @@index([uploadedById])
  @@map("meeting_files")
}

model TranscriptionJob {
  id             String                 @id @default(cuid())
  sourceFileId   String                 @unique @map("source_file_id")
  status         TranscriptionJobStatus @default(QUEUED)
  attemptCount   Int                    @default(0) @map("attempt_count")
  leaseOwner     String?                @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt DateTime?              @map("lease_expires_at")
  startedAt      DateTime?              @map("started_at")
  finishedAt     DateTime?              @map("finished_at")
  failureCode    String?                @map("failure_code") @db.VarChar(64)
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  sourceFile     MeetingFile            @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("transcription_jobs")
}

model MeetingSummary {
  id          String                   @id @default(cuid())
  meetingId   String                   @unique @map("meeting_id")
  status      MeetingSummaryStatus     @default(QUEUED)
  summaryText String?                  @map("summary_text")
  failureCode String?                  @map("failure_code") @db.VarChar(64)
  // Identity of the ready TRANSCRIPT file set this run was queued against —
  // see computeTranscriptFingerprint. Compared against the meeting's current
  // set to decide whether a finished run is stale and due for a recompute; an
  // empty string is what a row written before this column existed reads as,
  // which never matches a real fingerprint and so is treated as stale too.
  transcriptFingerprint String              @default("") @map("transcript_fingerprint")
  startedAt   DateTime?                @map("started_at")
  finishedAt  DateTime?                @map("finished_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  meeting     Meeting                  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tasks       MeetingSummaryTask[]
  decisions   MeetingSummaryDecision[]

  @@index([status, createdAt])
  @@map("meeting_summaries")
}

enum TaskStatus {
  TODO
  DONE
}

// Who wrote the row, not which transcript file it came from (that's
// `MeetingSummaryTaskSource` below). Set on create, and moved from `AGENT`
// to `MCP` — never back — when a client edits the row through
// `upsert_task`: once it says something the run did not write, no rerun can
// reproduce it. `MeetingSummaryService` reads it to decide what a summary rerun may
// clear: an `AGENT` task is that run's own output and gets recreated fresh
// every time, so wiping it first is correct; an `MCP` task is something a
// caller wrote through `upsert_task` and has no next run that will rewrite
// it, so a rerun must leave it alone or lose it permanently.
enum TaskOrigin {
  AGENT
  MCP
}

model MeetingSummaryTask {
  id        String                     @id @default(cuid())
  summaryId String                     @map("summary_id")
  title     String
  assignee  String?                    @map("assignee")
  status    TaskStatus                 @default(TODO)
  position  Int
  origin    TaskOrigin                 @default(AGENT)
  // Who this task is scoped to for MCP access: the meeting's owner for a task
  // the transcript agent wrote, or the caller who created it through
  // upsert_task. Nullable like Meeting.ownerId, whose value it starts from —
  // a task under an ownerless meeting is simply unreachable through MCP.
  ownerId   String?                    @map("owner_id")
  owner     User?                      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  summary   MeetingSummary             @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  sources   MeetingSummaryTaskSource[]

  @@index([summaryId, position])
  @@index([ownerId, status])
  @@map("meeting_summary_tasks")
}

// Tracks which transcript file(s) a task was drawn from. A future update
// merges the same task mentioned in more than one transcript into one row
// instead of one row per mention, and this table is where that merge is
// recorded — without it, a merged task has no way to say which files agreed
// on it. Deleting a transcript file only removes its link here: the task text
// this file contributed to stays, matching the rule that a summary survives
// the deletion of the files it was built from.
model MeetingSummaryTaskSource {
  taskId        String             @map("task_id")
  meetingFileId String             @map("meeting_file_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  task          MeetingSummaryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  meetingFile   MeetingFile        @relation(fields: [meetingFileId], references: [id], onDelete: Cascade)

  @@id([taskId, meetingFileId])
  @@index([meetingFileId])
  @@map("meeting_summary_task_sources")
}

model MeetingSummaryDecision {
  id        String         @id @default(cuid())
  summaryId String         @map("summary_id")
  text      String
  position  Int
  summary   MeetingSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId, position])
  @@map("meeting_summary_decisions")
}

model MeetingFileDownloadTicket {
  tokenHash      String      @id @map("token_hash") @db.Char(64)
  fileId         String      @map("file_id")
  issuedToUserId String      @map("issued_to_user_id")
  expiresAt      DateTime    @map("expires_at")
  usedAt         DateTime?   @map("used_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  file           MeetingFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  issuedTo       User        @relation(fields: [issuedToUserId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("meeting_file_download_tickets")
}
