{
  "name": "@video-meetings/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:generate && node --env-file=../../.env ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "npm run prisma:generate && nest build",
    "start": "node --env-file=../../.env dist/main.js",
    "worker": "node --env-file=../../.env dist/transcription/worker/main.js",
    "worker:dev": "npm run prisma:generate && node --env-file=../../.env ../../node_modules/@nestjs/cli/bin/nest.js start --watch --entryFile transcription/worker/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test:e2e": "npm run prisma:generate && jest --config ./test/jest-e2e.json --runInBand",
    "prisma": "node --env-file=../../.env ../../node_modules/prisma/build/index.js",
    "prisma:generate": "npm run prisma -- generate --schema ./prisma/schema.prisma",
    "prisma:migrate": "npm run prisma -- migrate dev --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^6.0.3",
    "jest": "^30.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
